#============================================================================
#  Network service to allow authorized clients.
#============================================================================
service {
    #------------------------------------------------------------------------
    #  A line like the following can be used to bind to a specific IP
    #  address instead of the wildcard.
    #------------------------------------------------------------------------
    addresses = [ { address = "inaddr_any"; tcpPort = 2126; },
                  { address = "in6addr_any"; tcpPort = 2126; } ];

    #------------------------------------------------------------------------
    #  Specify the IPv4 and IPv6 addresses and port to bind for UDP queries.
    #  Note these queries are unauthenticated and unencrypted.
    #------------------------------------------------------------------------
    udpAddresses = [ { address = "127.0.0.1"; udpPort = 2126; },
                     { address = "::1"; udpPort = 2126; } ];

    #------------------------------------------------------------------------
    #  Location of credence public key file (id_ed25519.pub), private key
    #  file (id_ed25519) and allowed client public keys file (known_keys).
    #------------------------------------------------------------------------
    keyDirectory = "/usr/local/etc/mccurtaind";
    
    #------------------------------------------------------------------------
    #  Access can be restricted to clients within given address ranges.
    #------------------------------------------------------------------------
    allowedClients = [
      "192.168.1/24", "127.0.0.1/32", "fd60:3019:f5a:5abf::0/64", "::1"
    ];
};

#============================================================================
#  syslog configuration.
#============================================================================
syslog {
    #------------------------------------------------------------------------
    #  Syslog facility.  Defaults to "daemon" if not set.
    #------------------------------------------------------------------------
    facility = "local0";
    
    #------------------------------------------------------------------------
    #  Minimum syslog priority to log.  Defaults to "info" if not set.
    #------------------------------------------------------------------------
    level = "debug";

    #------------------------------------------------------------------------
    #  Set to "yes" to get {filename:line} in syslog.
    #------------------------------------------------------------------------
    logLocations = "yes";
};

#============================================================================
#  databases configuration.
#============================================================================
databases {
    #------------------------------------------------------------------------
    #  AS <-> IP_prefix database file.  If not configured,
    #  /usr/local/etc/mccas2ip.db will be assumed.  This file can be created
    #  from CAIDA pfx2as files with mkcurtaindb(1).
    #  If the file extension is ".bz2", the file is assumed to be in bzip
    #  format.  If the file extension is ".gz", the file is assumed to be in
    #  gzip format.  Any other extension is assumed to be uncompressed.  Note
    #  that all formats are binary; decompressing the bzip2 or gzip formats
    #  yields a binary file.  The mccdb(1) utility can be used to dump
    #  the contents of the file in human readable form.
    #------------------------------------------------------------------------
    dbfile = "/usr/local/etc/mccas2ip.db";

    #------------------------------------------------------------------------
    #  RIPE asn.txt file location.  If not configured,
    #  /usr/local/etc/asn.txt will be assumed.  A current version of this
    #  file can be downloaded from RIPE's ftp site at
    #  http://ftp.ripe.net/ripe/asnames/asn.txt
    #------------------------------------------------------------------------
    asntxt = "/usr/local/etc/asn.txt";
};

